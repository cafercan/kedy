{
  "manifest_version": 3,
  "name": "Kedy - İmleç Takip Eden Kedi",
  "version": "0.1.0",
  "description": "Fare imlecinizi kafası ve gözleriyle canlı takip eden sevimli kedi eklentisi. Boyutu ve rengi ayarlanabilir.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Kedy Ayarları",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
